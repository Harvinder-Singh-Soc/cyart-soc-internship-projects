<!-- SOC Lab - Custom Wazuh Rules                   -->
<!-- File: /var/ossec/etc/rules/local_rules.xml     -->
<!-- ============================================= -->

<group name="syslog,sshd,">
  <rule id="100010" level="10">
    <decoded_as>json</decoded_as>
    <field name="sshd.auth">failed</field>
    <description>Multiple SSH failed login attempts detected (possible brute-force)</description>
    <group>authentication_failed,</group>
  </rule>
</group>